<Window x:Class="Dem2Krit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/Icon.ico"
        Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Image Source="Resources/Icon.png" Width="50" Height="50" Margin="0,0,10,0"/>
            <TextBlock Text="Авторизация" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Логин:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="TbLogin" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PbPassword" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

            <Button x:Name="BtnLogin" Content="Войти" Height="35" FontSize="14" 
                    Background="{StaticResource AccentColor}" Margin="0,0,0,10" Click="BtnLogin_Click"/>

            <Button x:Name="BtnGuest" Content="Войти как гость" Height="35" FontSize="14" 
                    Background="{StaticResource SecondaryBackground}" Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>