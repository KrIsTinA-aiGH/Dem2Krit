<Window x:Class="Dem2Krit.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="420" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оформление заказа" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Выбранный товар:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="TbProductName" FontSize="14" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <TextBlock Text="Пункт выдачи:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbPickupPoint" Height="25" Margin="0,0,0,15"/>

            <TextBlock Text="Количество:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TbCount" Text="1" Height="25" VerticalContentAlignment="Center" Margin="0,0,0,15" TextChanged="TbCount_TextChanged"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBlock x:Name="TbTotalSum" Text="Сумма к оплате: 0 руб." FontSize="15" FontWeight="Bold" Margin="0,0,15,0"/>
            </StackPanel>

            <TextBlock x:Name="TbCode" Text="Код получения: ---" FontSize="14" Foreground="DarkGreen" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Кнопки управления -->
        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnPrintReceipt" Content="Печать талона" Width="120" Height="32" Margin="0,0,10,0"
            Background="{StaticResource SecondaryBackground}" Click="BtnPrintReceipt_Click"/>
            <Button x:Name="BtnSaveOrder" Content="Сформировать заказ" Width="150" Height="32" Margin="0,0,10,0"
            Background="{StaticResource AccentColor}" Foreground="White" Click="BtnSaveOrder_Click"/>
            <Button x:Name="BtnClose" Content="Отмена" Width="90" Height="32" 
            Background="{StaticResource SecondaryBackground}" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>