<Window x:Class="Dem2Krit.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление / Редактирование товара" Height="550" Width="500"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/Icon.ico"
        Background="{StaticResource PrimaryBackground}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TbTitle" Text="Редактирование товара" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="Наименование товара:"/>
                <TextBox x:Name="TbName" Margin="0,2,0,10" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock Text="Категория товара:"/>
                <ComboBox x:Name="CmbCategory" Margin="0,2,0,10" Height="25"/>

                <TextBlock Text="Производитель:"/>
                <ComboBox x:Name="CmbManufacturer" Margin="0,2,0,10" Height="25"/>

                <TextBlock Text="Поставщик:"/>
                <ComboBox x:Name="CmbSupplier" Margin="0,2,0,10" Height="25"/>

                <TextBlock Text="Цена (руб):"/>
                <TextBox x:Name="TbPrice" Margin="0,2,0,10" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock Text="Скидка (%):"/>
                <TextBox x:Name="TbDiscount" Margin="0,2,0,10" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock Text="Количество на складе:"/>
                <TextBox x:Name="TbCount" Margin="0,2,0,10" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock Text="Описание:"/>
                <TextBox x:Name="TbDescription" Margin="0,2,0,10" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- Блок работы с изображением -->
                <TextBlock Text="Изображение товара:"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                    <Image x:Name="ImgProduct" Width="80" Height="80" Stretch="Uniform" Margin="0,0,15,0"/>
                    <Button x:Name="BtnSelectImage" Content="Выбрать фото" Width="110" Height="30" VerticalAlignment="Center" Click="BtnSelectImage_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки Сохранить / Отмена -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnSave" Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" 
                    Background="{StaticResource AccentColor}" Foreground="White" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Отмена" Width="100" Height="30" 
                    Background="{StaticResource SecondaryBackground}" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>