<Window x:Class="Dem2Krit.OrdersListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список заказов" Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackground}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="История и список заказов" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="DgOrders" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" SelectionMode="Single" HorizontalContentAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа" Binding="{Binding ID}" Width="80"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding data_zakaza, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130"/>
                <DataGridTextColumn Header="Дата доставки" Binding="{Binding data_dostavki, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding pynkt_vydachu.FullAddress}" Width="*"/>
                <DataGridTextColumn Header="Код получения" Binding="{Binding kod_polychenia}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnClose" Content="Закрыть" Width="100" Height="30" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>